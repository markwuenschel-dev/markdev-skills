{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ria.composite-v2.config.schema.json",
  "title": "RIA composite v2 scoring configuration (composite-scoring-v3 §13)",
  "description": "Closed contract for RIA-owned scoring numbers. Owner-owned factors are referenced through imports and never copied. Semantic constraints (§4.2) are enforced by composite-v2-config.js after schema validation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "config_version",
    "owners",
    "dimensions",
    "eligibility",
    "sei_confidence",
    "contested",
    "confidence_bands",
    "integrity_scoring",
    "integrity_surface_map",
    "integrity_defect_checks",
    "lane_dimension_map",
    "dependence",
    "status",
    "caps",
    "critical_floor",
    "imports"
  ],
  "properties": {
    "schema_version": {
      "const": "ria.composite-v2.config@1"
    },
    "config_version": {
      "type": "string",
      "pattern": "^[0-9]+[.][0-9]+[.][0-9]+$"
    },
    "owners": {
      "const": [
        "health",
        "architecture",
        "integrity",
        "sei"
      ]
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "correctness",
        "architecture",
        "contracts",
        "verification",
        "delivery",
        "maintainability",
        "security",
        "reliability",
        "change_and_docs"
      ],
      "properties": {
        "correctness": {
          "$ref": "#/$defs/dimension"
        },
        "architecture": {
          "$ref": "#/$defs/dimension"
        },
        "contracts": {
          "$ref": "#/$defs/dimension"
        },
        "verification": {
          "$ref": "#/$defs/dimension"
        },
        "delivery": {
          "$ref": "#/$defs/dimension"
        },
        "maintainability": {
          "$ref": "#/$defs/dimension"
        },
        "security": {
          "$ref": "#/$defs/dimension"
        },
        "reliability": {
          "$ref": "#/$defs/dimension"
        },
        "change_and_docs": {
          "$ref": "#/$defs/dimension"
        }
      }
    },
    "eligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "health",
        "architecture",
        "integrity",
        "sei"
      ],
      "properties": {
        "health": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min_weighted_coverage",
            "established_min_weighted_coverage"
          ],
          "properties": {
            "min_weighted_coverage": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "established_min_weighted_coverage": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          }
        },
        "architecture": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min_mapped_coverage"
          ],
          "properties": {
            "min_mapped_coverage": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "integrity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scored_min_coverage",
            "provisional_min_coverage"
          ],
          "properties": {
            "scored_min_coverage": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "provisional_min_coverage": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "sei": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "eligible_maturities",
            "ineligible_confidences"
          ],
          "properties": {
            "eligible_maturities": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "provisional",
                  "established"
                ]
              }
            },
            "ineligible_confidences": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "HIGH",
                  "MODERATE",
                  "LOW",
                  "NOT_ESTABLISHED"
                ]
              }
            }
          }
        }
      }
    },
    "sei_confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "HIGH",
        "MODERATE",
        "LOW"
      ],
      "properties": {
        "HIGH": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "MODERATE": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "LOW": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "contested": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spread_threshold",
        "decay_divisor",
        "minimum_multiplier"
      ],
      "properties": {
        "spread_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "decay_divisor": {
          "type": "number",
          "minimum": 1
        },
        "minimum_multiplier": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "confidence_bands": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "high",
        "moderate"
      ],
      "properties": {
        "high": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "moderate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "integrity_scoring": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "no_defect_score",
        "severity_schedule"
      ],
      "properties": {
        "no_defect_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "severity_schedule": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "severity",
              "ceiling",
              "step",
              "floor"
            ],
            "properties": {
              "severity": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "ceiling": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "step": {
                "type": "number",
                "minimum": 0
              },
              "floor": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              }
            }
          }
        }
      }
    },
    "integrity_surface_map": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "correctness",
        "contracts",
        "security",
        "reliability"
      ],
      "properties": {
        "correctness": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "contracts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "security": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reliability": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "integrity_defect_checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "correctness",
        "contracts",
        "security",
        "reliability"
      ],
      "properties": {
        "correctness": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "logic-error",
              "contract-drift",
              "missing-validation",
              "security-exposure",
              "failure-handling",
              "concurrency",
              "data-integrity",
              "stale-or-dead-path",
              "other"
            ]
          }
        },
        "contracts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "logic-error",
              "contract-drift",
              "missing-validation",
              "security-exposure",
              "failure-handling",
              "concurrency",
              "data-integrity",
              "stale-or-dead-path",
              "other"
            ]
          }
        },
        "security": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "logic-error",
              "contract-drift",
              "missing-validation",
              "security-exposure",
              "failure-handling",
              "concurrency",
              "data-integrity",
              "stale-or-dead-path",
              "other"
            ]
          }
        },
        "reliability": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "logic-error",
              "contract-drift",
              "missing-validation",
              "security-exposure",
              "failure-handling",
              "concurrency",
              "data-integrity",
              "stale-or-dead-path",
              "other"
            ]
          }
        }
      }
    },
    "lane_dimension_map": {
      "type": "object",
      "description": "Health lane id -> RIA defect dimensions; keys are checked against the imported HEALTH_LANE_DEFINITIONS by the loader."
    },
    "dependence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adopted_strength_threshold"
      ],
      "properties": {
        "adopted_strength_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "not_gradable_min_scored_weight_ratio"
      ],
      "properties": {
        "not_gradable_min_scored_weight_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "caps": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ceilings",
        "rules",
        "confirmed_critical_min_severity"
      ],
      "properties": {
        "ceilings": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "C",
            "D+",
            "D"
          ],
          "properties": {
            "C": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "D+": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "D": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          }
        },
        "rules": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "verification-tests-failing",
            "verification-checks-failing",
            "confirmed-critical-failure",
            "critical-dimension-floor"
          ],
          "properties": {
            "verification-tests-failing": {
              "enum": [
                "C",
                "D+",
                "D"
              ]
            },
            "verification-checks-failing": {
              "enum": [
                "C",
                "D+",
                "D"
              ]
            },
            "confirmed-critical-failure": {
              "enum": [
                "C",
                "D+",
                "D"
              ]
            },
            "critical-dimension-floor": {
              "enum": [
                "C",
                "D+",
                "D"
              ]
            }
          }
        },
        "confirmed_critical_min_severity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        }
      }
    },
    "critical_floor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "point_below",
        "min_independent_established_sources"
      ],
      "properties": {
        "point_below": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "min_independent_established_sources": {
          "type": "integer",
          "minimum": 2
        }
      }
    },
    "imports": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grade_bands",
        "health_evidence_factor",
        "health_coverage_credit",
        "health_default_surfaces",
        "health_lane_definitions",
        "architecture_fitness_weights",
        "sei_rubric",
        "evidence_qualities",
        "coverage_states"
      ],
      "properties": {
        "grade_bands": {
          "$ref": "#/$defs/import"
        },
        "health_evidence_factor": {
          "$ref": "#/$defs/import"
        },
        "health_coverage_credit": {
          "$ref": "#/$defs/import"
        },
        "health_default_surfaces": {
          "$ref": "#/$defs/import"
        },
        "health_lane_definitions": {
          "$ref": "#/$defs/import"
        },
        "architecture_fitness_weights": {
          "$ref": "#/$defs/import"
        },
        "sei_rubric": {
          "$ref": "#/$defs/import"
        },
        "evidence_qualities": {
          "$ref": "#/$defs/import"
        },
        "coverage_states": {
          "$ref": "#/$defs/import"
        }
      }
    }
  },
  "$defs": {
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "weight",
        "critical",
        "sources",
        "shares"
      ],
      "properties": {
        "weight": {
          "type": "number",
          "minimum": 0
        },
        "critical": {
          "type": "boolean"
        },
        "sources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "health": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "lane"
              ],
              "properties": {
                "lane": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "architecture": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "fitness_dimensions"
              ],
              "properties": {
                "fitness_dimensions": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "integrity": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "defect_dimension"
              ],
              "properties": {
                "defect_dimension": {
                  "enum": [
                    "correctness",
                    "contracts",
                    "security",
                    "reliability"
                  ]
                }
              }
            },
            "sei": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "dimensions"
              ],
              "properties": {
                "dimensions": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        "shares": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "health": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "architecture": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "integrity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "sei": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      }
    },
    "import": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module",
        "loader",
        "export"
      ],
      "properties": {
        "module": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9/._-]*$"
        },
        "loader": {
          "enum": [
            "commonjs",
            "json",
            "global:HealthVerify"
          ]
        },
        "export": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
