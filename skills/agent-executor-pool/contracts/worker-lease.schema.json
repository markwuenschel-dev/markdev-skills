{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-executor-pool:worker-lease:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "assignment_id",
    "generation",
    "fence_token",
    "worker_identity",
    "status",
    "leased_at",
    "heartbeat_at",
    "expires_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "assignment_id": {
      "type": "string",
      "minLength": 1
    },
    "generation": {
      "type": "integer",
      "minimum": 1
    },
    "fence_token": {
      "type": "string",
      "minLength": 16
    },
    "worker_identity": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "active",
        "completed",
        "failed",
        "cancelled",
        "stale"
      ]
    },
    "leased_at": {
      "type": "string",
      "minLength": 1
    },
    "heartbeat_at": {
      "type": "string",
      "minLength": 1
    },
    "expires_at": {
      "type": "string",
      "minLength": 1
    },
    "result_ref": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
