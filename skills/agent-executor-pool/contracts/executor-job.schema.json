{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-executor-pool:job:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "job_id",
    "scope_id",
    "class",
    "dependencies",
    "resources",
    "priority",
    "executor_depth",
    "mutating"
  ],
  "properties": {
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "scope_id": {
      "type": "string",
      "minLength": 1
    },
    "class": {
      "enum": [
        "read_only",
        "implementation",
        "validation",
        "integration",
        "publication"
      ]
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "mode",
          "permits"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "mode": {
            "enum": [
              "shared",
              "exclusive"
            ]
          },
          "permits": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "priority": {
      "type": "number"
    },
    "executor_depth": {
      "type": "integer",
      "minimum": 0
    },
    "mutating": {
      "type": "boolean"
    }
  }
}
