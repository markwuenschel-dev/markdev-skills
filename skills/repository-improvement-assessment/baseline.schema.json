{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://markdev-skills.local/repository-improvement-assessment/baseline.schema.json",
  "title": "RIA deterministic baseline",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_id", "content_sha256", "repository", "generated_protected_paths", "command_authorization", "verification_contract", "sei_compatibility_binding", "history_binding", "environment_toolchain", "provenance"],
  "properties": {
    "schema_version": { "const": "ria.baseline@1" },
    "artifact_id": { "type": "string", "pattern": "^ria-baseline:[0-9a-f]{64}$" },
    "content_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "repository": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "scope", "repository_id", "revision", "roots", "ancestor_reuse_allowed"],
      "properties": {
        "mode": { "enum": ["git", "content-addressed-degraded"] },
        "scope": { "enum": ["head", "worktree"] },
        "repository_id": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "revision": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
        "ancestor_reuse_allowed": { "type": "boolean" },
        "roots": { "type": "array", "minItems": 1, "items": { "type": "object" } }
      }
    },
    "generated_protected_paths": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["kind", "path", "root_index", "purpose"],
        "properties": {
          "kind": { "enum": ["exact-existing", "allowed-absent-generated", "pattern"] },
          "path": { "type": "string", "minLength": 1 },
          "root_index": { "type": "integer", "minimum": 0 },
          "purpose": { "type": ["string", "null"] }
        }
      }
    },
    "command_authorization": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "authorization_ref", "inherited_from", "commands"],
      "properties": {
        "state": { "enum": ["granted", "denied", "inherited"] },
        "authorization_ref": { "type": ["string", "null"] },
        "inherited_from": { "type": ["string", "null"] },
        "commands": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "verification_contract": { "type": "object" },
    "sei_compatibility_binding": {
      "type": "object",
      "required": ["engine_version", "effective_configuration", "config_hash", "execution_contract_hash", "history_window", "history_window_hash", "assessment_schema_version", "analyzer_capabilities", "analyzer_capability_hash"],
      "properties": {
        "engine_version": { "type": "string", "minLength": 1 },
        "effective_configuration": { "type": "object" },
        "config_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "execution_contract_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "history_window": { "type": "object" },
        "history_window_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "assessment_schema_version": { "type": "string", "minLength": 1 },
        "analyzer_capabilities": { "type": "object" },
        "analyzer_capability_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "history_binding": { "type": "object" },
    "environment_toolchain": { "type": "object" },
    "provenance": { "type": "object" }
  }
}
