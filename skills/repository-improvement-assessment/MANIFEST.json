  "returns": "assess-projection-v1",
  "exports": [
    "task3-contract-check",
    "engineering-intelligence",
    "engineering-intelligence-writer",
    "engineering-intelligence-reader",
    "engineering-intelligence-assessment",
    "ria-public-runtime"
  ],
  "determinism": {
    "external_dependencies": false,
    "node_builtins_only": true,
    "mutation_code_in_trial_harness": false
  },
  "depends_on": [
    "shared/assessment-acceleration",
    "agent-executor-pool",
    "shared/software-engineering-intelligence",
    "shared/report-election",
    "shared/report-presentation",
    "shared/assessment-runtime-contract",
    "shared/assessment-verification-baseline",
    "shared/project-intelligence-workspace",
    "shared/ria-owner-return",
    "shared/candidate-ledger-spine",
    "repository-health-assessment",
    "codebase-integrity-audit-loop",
    "architecture-improvement-intelligence",
    "shared/ria-scoring"
  ],
  "performance": {
    "profile": "global-content-addressed-execution-dag-v2",
    "startup_modes": [
      "EXACT_REUSE",
      "INCREMENTAL_REUSE",
      "FRESH_BASELINE"
    ],
    "root_global_pool": true,
    "sei_and_verification_overlap": true,
    "owners_start_concurrently": true,
    "owner_artifact_reuse": true,
    "child_runtime_contracts_parallel": true,
    "owner_packets_flatten_when_possible": true,
    "nested_full_size_swarms": false,
    "work_conserving_refill": true,
    "incremental_normalization": true
  },
  "presentation": {
    "report_policy": "ask|generate|skip|inherit",
    "interactive_default": "ask after canonical ASSESS projection",
    "child_policy": "inherit",
    "report_owner": "repository-improvement-assessment",
    "canonical_projection_independent_of_report": true
  },
  "reporting": {
    "data_model": "ria-report-data-v3",
    "artifact_binding": "required",
    "quantitative_visualizations": "required-when-data-exists",
    "responsive_canvas": "shared/report-presentation",
    "production_demo_inputs": "rejected",
    "composite_score": "weighted-six-dimension-a-plus-minus",
    "coverage_metrics": [
      "line",
      "branch",
      "changed_line"
    ],
    "progressive_disclosure": true,
    "composite_v2": "ria.composite@2 uncalibrated shadow beside v1 (composite-scoring-v3 D6); v1 remains reported"
  },
  "storage": {
    "workspace": "shared/project-intelligence-workspace@1",
    "durable_root": ".project-intelligence",
    "engineering_intelligence": "evidence/engineering-intelligence",
    "reports": "reports/ria",
    "legacy_read_compatibility": [
      ".autonomous-loop/assessment-artifacts/engineering-intelligence"
    ],
    "tracked_source_mutation": false,
    "lineage": "lineage/ria-artifacts.json",
    "owner_cache": "cache/ria-owner-artifacts",
    "assess_projection": "assessments/ria"
  },
  "assets": [
    "assets/report-scaffold.html",
    "assets/icon.svg",
    "baseline.example.json",
    "context-policy.json",
    "openai.yaml",
    "agents/openai.yaml",
    "assets/design/ria-report-handoff/README.md",
    "assets/design/ria-report-handoff/Repository Improvement Assessment.dc.html",
    "assets/design/ria-report-handoff/support.js"
  ]
}
