{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://markdev-skills.local/repository-improvement-assessment/ria-performance-receipt.schema.json", "title": "RIA event-derived performance receipt v2", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "run_id", "generated_at", "telemetry_status", "telemetry_failure_code", "metrics", "critical_path_task_ids", "class_budgets", "tasks", "receipt_sha256"],
  "properties": {
    "schema_version": { "const": "ria.performance-receipt@2" },
    "run_id": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "telemetry_status": { "enum": ["available", "unavailable"] },
    "telemetry_failure_code": { "type": ["string", "null"] },
    "metrics": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object", "additionalProperties": false,
          "required": ["serial_work_ms", "critical_path_ms", "actual_wall_ms", "scheduler_overhead_ms", "cache_reuse_savings_ms", "parallelism_factor", "peak_concurrency", "ready_queue_peak", "ready_queue_time_ms", "resource_blocked_time_ms", "tool_calls", "tokens"],
          "properties": {
            "serial_work_ms": { "$ref": "#/$defs/metric" }, "critical_path_ms": { "$ref": "#/$defs/metric" }, "actual_wall_ms": { "$ref": "#/$defs/metric" }, "scheduler_overhead_ms": { "$ref": "#/$defs/metric" }, "cache_reuse_savings_ms": { "$ref": "#/$defs/metric" }, "parallelism_factor": { "$ref": "#/$defs/metric" }, "peak_concurrency": { "$ref": "#/$defs/metric" }, "ready_queue_peak": { "$ref": "#/$defs/metric" }, "ready_queue_time_ms": { "$ref": "#/$defs/metric" }, "resource_blocked_time_ms": { "$ref": "#/$defs/metric" }, "tool_calls": { "$ref": "#/$defs/metric" }, "tokens": { "$ref": "#/$defs/metric" }
          }
        }
      ]
    },
    "critical_path_task_ids": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "class_budgets": { "type": "object", "additionalProperties": false, "properties": { "local-deterministic": { "type": "integer", "minimum": 1 }, "heavy-tool": { "type": "integer", "minimum": 1 }, "agent": { "type": "integer", "minimum": 1 } } },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["task_id", "owner", "executor_class", "state", "duration_ms", "ready_wait_ms", "resource_blocked_ms", "tool_calls", "tokens", "cache_disposition", "estimated_avoided_ms"],
        "properties": {
          "task_id": { "type": "string", "minLength": 1 }, "owner": { "type": "string", "minLength": 1 }, "executor_class": { "enum": ["local-deterministic", "heavy-tool", "agent"] }, "state": { "enum": ["reused", "completed", "failed", "blocked", "cancelled"] }, "duration_ms": { "type": "number", "minimum": 0 }, "ready_wait_ms": { "type": ["number", "null"], "minimum": 0 }, "resource_blocked_ms": { "type": ["number", "null"], "minimum": 0 }, "tool_calls": { "$ref": "#/$defs/metric" }, "tokens": { "$ref": "#/$defs/metric" }, "cache_disposition": { "enum": ["EXACT_REUSE", "MISS", "NOT_APPLICABLE"] }, "estimated_avoided_ms": { "type": "number", "minimum": 0 }
        }
      }
    },
    "receipt_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "$defs": {
    "metric": { "type": "object", "additionalProperties": false, "required": ["value", "evidence"], "properties": { "value": { "type": ["number", "null"], "minimum": 0 }, "evidence": { "enum": ["measured", "estimated", "unavailable"] } } }
  }
}
