{
  "schema_version": 2,
  "core": [
    "COVERAGE-MODEL.md",
    "EVIDENCE-RECON-ADAPTER.md",
    "HEALTH-GRADING.md",
    "PARALLEL-ASSESSMENT.md",
    "PERFORMANCE.md",
    "REVIEW-LANES.md",
    "SKILL.md"
  ],
  "conditional": {
    "evaluation": {
      "condition_ids": [
        "context.repository-health-assessment.evaluation"
      ],
      "refs": [
        "evals/evals.json"
      ]
    },
    "migration": {
      "condition_ids": [
        "context.repository-health-assessment.migration"
      ],
      "refs": [
        "MIGRATIONS.md"
      ]
    },
    "report": {
      "condition_ids": [
        "context.repository-health-assessment.report"
      ],
      "refs": [
        "assets/report-scaffold.html",
        "HTML-REPORT.md"
      ]
    },
    "ria": {
      "condition_ids": [
        "context.repository-health-assessment.ria"
      ],
      "refs": [
        "RIA-MODE.md"
      ]
    }
  },
  "oracle": {
    "default_model_read": false,
    "retrieval": "section",
    "sources": {
      "source.assets.health-verify.js": {
        "path": "assets/health-verify.js",
        "selector": "symbol"
      },
      "source.assets.package-check.js": {
        "path": "assets/package-check.js",
        "selector": "symbol"
      },
      "source.assets.parity-check.js": {
        "path": "assets/parity-check.js",
        "selector": "symbol"
      }
    }
  },
  "fixtures": {
    "default_model_read": false
  },
  "historical": {
    "default_model_read": false
  }
}
