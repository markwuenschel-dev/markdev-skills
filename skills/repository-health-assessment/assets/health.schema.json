  "$defs": {
    "dimension": {
      "type": "object",
      "required": [
        "level",
        "claim_refs",
        "rationale"
      ],
      "additionalProperties": false,
      "description": "Support is declared per dimension. A bare number is rejected: it carries no audit trail, and it was what allowed one broad claim to justify an entire lane.",
      "properties": {
        "level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4,
          "description": "0 absent/no trustworthy evidence, 1 ad hoc, 2 partial, 3 mostly systematic, 4 systematic and regression-resistant. Level >= 2 needs at least one supporting claim resulting pass or partial; level 4 needs at least one resulting pass; a dimension supported only by unknown claims cannot exceed level 1; level <= 1 must not rest solely on passing claims."
        },
        "claim_refs": {
          "type": "array",
          "minItems": 1,
          "description": "Each reference names a real claim in this same lane and states what it supports for THIS dimension. The object form exists because a bare id repeated across six dimensions is a rubber stamp; six distinct support lines are an argument. Reusing one claim with an identical support line is rejected.",
          "items": {
            "type": "object",
            "required": [
              "claim_id",
              "support"
            ],
            "additionalProperties": false,
            "properties": {
              "claim_id": {
                "type": "string",
                "minLength": 1
              },
              "support": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "rationale": {
