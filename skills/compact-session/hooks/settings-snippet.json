{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/skills/compact-session/hooks/context_nudge.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "auto",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/skills/compact-session/hooks/precompact_marker.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}