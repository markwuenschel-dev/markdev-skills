    "engine": "node",
    "dependencies": [],
    "shared_acceleration": "shared/assessment-acceleration",
    "shared_evidence": "shared/evidence-recon",
    "executor": "agent-executor-pool"
  },
  "performance": {
    "profile": "aggressive-threadpool-v2",
    "cardinality": "adaptive topology-derived; no arbitrary small fixed worker count",
    "agent_workers": "auto aggressive, runtime-bounded",
    "command_workers": "separate conservative resource-aware budget",
    "deterministic_workers": "parallel where independent",
    "synthesis_workers": "bounded incremental per-surface",
    "queue_target": "queue_multiplier x active agent workers when genuine READY work exists",
    "work_conserving_refill": true,
    "as_completed_consumption": true,
    "work_stealing": true,
    "critical_path_splitting": true,
    "single_flight": true,
    "warm_starts": true,
    "pipeline_overlap": true,
    "nested_under_ria": "flatten into RIA global pool",
    "report_runtime_network": false,
    "view_time_graph_renderer": false,
    "report_layout": "responsive widescreen/ultrawide analytics"
  },
  "authority": {
    "repository_mutation": false,
    "decision_graph_owner": "decision-terrain-mapper",
    "architecture_judgment_owner": "architecture-improvement-intelligence",
    "evidence_contract_owner": "shared/evidence-recon",
    "score_contract_owner": "shared/candidate-ledger-spine"
  },
  "presentation": {
    "canonical_machine_artifact": "architecture_candidate_set",
    "interactive_report_default": "ask",
    "assessment_under_ria": "inherit",
    "report_optional": true
  },
  "storage": {
    "workspace": "shared/project-intelligence-workspace@1",
    "durable_root": ".project-intelligence",
    "reports": "reports/architecture",
    "external_durable_state": false,
    "candidate_sets": "assessments/architecture"
  },
  "candidate_set_writer": "assets/write-candidate-set.js",
  "architecture_fitness": {
    "schema": "architecture.fitness@2",
    "runtime": "assets/architecture-fitness.js",
    "candidate_priority_separate": true,
    "legacy_read_schema": "architecture.fitness@1"
  }
