{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://markdev-skills.local/architecture-improvement-intelligence/architecture-fitness.schema.json",
  "title": "Repository architecture fitness compatibility schema",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "score",
        "grade",
        "coverage",
        "confidence",
        "dimensions",
        "weights"
      ],
      "properties": {
        "schema_version": {
          "const": "architecture.fitness@1"
        },
        "score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "grade": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "A+",
            "A",
            "A-",
            "B+",
            "B",
            "B-",
            "C+",
            "C",
            "C-",
            "D+",
            "D",
            "D-",
            "F",
            null
          ]
        },
        "coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "dimensions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "boundary_integrity",
            "dependency_direction_cycle_control",
            "cohesion_locality",
            "interface_contract_clarity",
            "state_data_ownership",
            "change_containment_evolvability",
            "duplication_competing_implementations",
            "architectural_testability_observability"
          ],
          "properties": {
            "boundary_integrity": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 100
            },
            "dependency_direction_cycle_control": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 100
            },
            "cohesion_locality": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 100
            },
            "interface_contract_clarity": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 100
            },
            "state_data_ownership": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 100
            },
            "change_containment_evolvability": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 100
            },
            "duplication_competing_implementations": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 100
            },
            "architectural_testability_observability": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 100
            }
          }
        },
        "weights": {
          "type": "object"
        }
      }
    },
    {
      "$ref": "architecture-fitness-v2.schema.json"
    }
  ]
}
