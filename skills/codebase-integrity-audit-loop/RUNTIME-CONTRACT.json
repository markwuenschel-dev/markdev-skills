{
  "schema_version": "assessment-runtime-contract@1",
  "owner": "codebase-integrity-audit-loop",
  "version": "2.2.0",
  "entrypoint": "SKILL.md",
  "input": {
    "required": ["baseline_ref", "engineering_intelligence_ref", "verification_baseline_ref"],
    "optional": ["sei_assessment_ref", "presentation_policy"]
  },
  "output": {
    "kind": "integrity-candidate-ledger",
    "schema": "candidate-ledger-spine@3",
    "immutable": true,
    "reference_fields": ["owner", "artifact_id", "sha256", "repository_revision"],
    "ria_mode": { "coverage_schema": "integrity.coverage@2", "coverage_verifier": "assets/integrity-coverage.js", "minted_row_fields": ["ria_dimensions", "defect_class", "ria_proof"] }
  },
  "authority": {
    "owns": ["integrity candidates", "integrity evidence", "candidate disposition"],
    "does_not_own": ["repository health grade", "architecture judgment", "lifecycle routing", "tracked source mutation", "implementation worktrees or commits", "verification or completion"],
    "source_repository_mutation": false
  },
  "presentation": { "supports_report": true, "accepts_inherit": true, "canonical_independent_of_report": true },
  "verification": { "consumes_shared_baseline": true, "targeted_reverification_allowed": true },
  "execution": { "executor_class": "hybrid", "flatten_under_ria": true, "full_skill_read_by_parent": false }
}
